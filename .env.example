# GEMINI_API_KEY: Required for Muavin AI Gemini calls on the backend.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Supported @google/genai model name for Muavin AI (defaults to gemini-4-hydrogen)
GEMINI_MODEL="gemini-4-hydrogen"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT=3000

# Admin Authorization & Session Security
# ADMIN_EMAIL: Authorized Google account email for Firebase Admin Sign-In (defaults to sunbulbroter@gmail.com)
ADMIN_EMAIL="sunbulbroter@gmail.com"
# SESSION_SECRET: Random secret string used to sign admin session tokens
SESSION_SECRET=""
# Optional one-time bootstrap credentials for password-based admin login (or use CLI setup script)
ADMIN_INITIAL_EMAIL=""
ADMIN_INITIAL_PASSWORD=""

# Persistent File Storage Directory for CV PDFs, Gallery, Awards & Certificates
# Defaults to ./uploads locally; set to a mounted persistent disk path in production
UPLOAD_DIR="./uploads"

# SMTP Configuration for Contact Form Email Delivery
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="portfolio@ateequrrehman.dev"
CONTACT_TO_EMAIL="sunbulbroter@gmail.com"

# Cloud SQL Runtime Environment Variables (injected automatically by AI Studio Cloud SQL)
# SQL_HOST, SQL_DB_NAME, SQL_USER, SQL_PASSWORD, SQL_ADMIN_USER, SQL_ADMIN_PASSWORD
